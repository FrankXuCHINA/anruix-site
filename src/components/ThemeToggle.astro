---
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro.currentLocale);
---

<button
  id="theme-toggle"
  type="button"
  class="hover:text-accent flex size-9 items-center justify-center border-0 bg-transparent p-0 transition duration-150 active:scale-95 motion-reduce:transition-none"
  aria-label={t.a11y.switchToDarkMode}
  title={t.a11y.switchToDarkMode}
  data-label-to-light={t.a11y.switchToLightMode}
  data-label-to-dark={t.a11y.switchToDarkMode}
>
  <IconSunHigh
    data-theme-icon="light"
    aria-hidden="true"
    class="size-5 dark:hidden"
  />
  <IconMoon
    data-theme-icon="dark"
    aria-hidden="true"
    class="hidden size-5 dark:block"
  />
</button>
