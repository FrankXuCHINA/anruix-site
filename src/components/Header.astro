---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import profileAvatar from "@/assets/images/profile/profile-avatar.png";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconX from "@/assets/icons/IconX.svg";
import LinkButton from "./LinkButton.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);
const isHome = currentPath === "" || currentPath === "/";

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="border-border bg-card text-accent absolute inset-s-4 -top-full z-[60] rounded-full border px-4 py-2 transition-all duration-150 focus:top-2"
>
  {t.a11y.skipToContent}
</a>

<header class="site-header">
  <nav class="site-nav">
    <div class="site-nav-inner flex flex-wrap items-center">
      <a
        href={getRelativeLocaleUrl(locale, "")}
        class:list={[
          "hover:text-accent order-1 flex min-h-9 items-center gap-2.5 font-semibold whitespace-nowrap transition-colors duration-150",
          { "active-nav": isHome },
        ]}
        aria-label={t.notFound.goHome}
        aria-current={isHome ? "page" : undefined}
      >
        <Image
          src={profileAvatar}
          alt=""
          width={1024}
          height={1024}
          format="png"
          class="size-7 flex-none rounded-full object-cover"
        />
        <span class="text-base sm:text-[1.0625rem]">{site.title}</span>
      </a>

      <div
        class="order-2 ms-auto flex items-center gap-1 sm:order-3 sm:ms-2 sm:gap-1.5"
      >
        {
          features.search !== false && (
            <LinkButton
              href={getRelativeLocaleUrl(locale, "search")}
              class:list={[
                "hover:text-accent flex size-9 justify-center p-0",
                { "active-nav": isActive("/search") },
              ]}
              title={t.nav.search}
              aria-label={t.nav.search}
              aria-current={isActive("/search") ? "page" : undefined}
            >
              <IconSearch aria-hidden="true" class="size-5" />
              <span class="sr-only">{t.nav.search}</span>
            </LinkButton>
          )
        }

        {features.lightAndDarkMode && <ThemeToggle />}

        <button
          id="menu-btn"
          type="button"
          class="hover:text-accent flex size-9 items-center justify-center border-0 bg-transparent p-0 transition-colors duration-150 sm:hidden"
          aria-label={t.a11y.openMenu}
          aria-expanded="false"
          aria-controls="menu-items"
          data-label-open={t.a11y.openMenu}
          data-label-close={t.a11y.closeMenu}
        >
          <IconMenuDeep id="menu-icon" aria-hidden="true" class="size-5" />
          <IconX id="close-icon" aria-hidden="true" class="hidden size-5" />
        </button>
      </div>

      <ul
        id="menu-items"
        class="[&>li>a]:hover:text-accent order-3 hidden w-full basis-full grid-cols-1 gap-1 pt-2 pb-3 sm:order-2 sm:ms-auto sm:flex sm:w-auto sm:basis-auto sm:items-center sm:gap-1 sm:p-0 [&>li>a]:flex [&>li>a]:min-h-9 [&>li>a]:items-center [&>li>a]:rounded-lg [&>li>a]:px-3 [&>li>a]:font-medium [&>li>a]:transition-colors [&>li>a]:duration-150 sm:[&>li>a]:justify-center sm:[&>li>a]:px-2"
      >
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class:list={{ "active-nav": isActive("/posts") }}
            aria-current={isActive("/posts") ? "page" : undefined}
          >
            {t.nav.posts}
          </a>
        </li>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "tags")}
            class:list={{ "active-nav": isActive("/tags") }}
            aria-current={isActive("/tags") ? "page" : undefined}
          >
            {t.nav.tags}
          </a>
        </li>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "about")}
            class:list={{ "active-nav": isActive("/about") }}
            aria-current={isActive("/about") ? "page" : undefined}
          >
            {t.nav.about}
          </a>
        </li>
        {
          features.showArchives && (
            <li>
              <LinkButton
                href={getRelativeLocaleUrl(locale, "archives")}
                class:list={[
                  "gap-2 sm:size-9 sm:p-0",
                  { "active-nav": isActive("/archives") },
                ]}
                title={t.nav.archives}
                aria-label={t.nav.archives}
                aria-current={isActive("/archives") ? "page" : undefined}
              >
                <IconArchive aria-hidden="true" class="size-5" />
                <span class="sm:sr-only">{t.nav.archives}</span>
              </LinkButton>
            </li>
          )
        }
      </ul>
    </div>
  </nav>
</header>

<script>
  function setupMobileMenu() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuItems = document.querySelector<HTMLElement>("#menu-items");
    const menuIcon = document.querySelector<HTMLElement>("#menu-icon");
    const closeIcon = document.querySelector<HTMLElement>("#close-icon");
    const nav = menuBtn?.closest("nav");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon || !nav) return;
    if (menuBtn.dataset.menuBound === "true") return;
    menuBtn.dataset.menuBound = "true";

    const openLabel = menuBtn.dataset.labelOpen ?? "打开菜单";
    const closeLabel = menuBtn.dataset.labelClose ?? "关闭菜单";

    const setMenuOpen = (open: boolean) => {
      menuBtn.setAttribute("aria-expanded", String(open));
      menuBtn.setAttribute("aria-label", open ? closeLabel : openLabel);
      menuItems.classList.toggle("hidden", !open);
      menuItems.classList.toggle("grid", open);
      menuIcon.classList.toggle("hidden", open);
      closeIcon.classList.toggle("hidden", !open);
    };

    menuBtn.addEventListener("click", () => {
      setMenuOpen(menuBtn.getAttribute("aria-expanded") !== "true");
    });

    menuItems.addEventListener("click", event => {
      if ((event.target as Element).closest("a")) setMenuOpen(false);
    });

    nav.addEventListener("keydown", event => {
      if (event.key === "Escape") {
        setMenuOpen(false);
        menuBtn.focus();
      }
    });
  }

  setupMobileMenu();
  document.addEventListener("astro:after-swap", setupMobileMenu);
</script>
