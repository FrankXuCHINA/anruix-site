---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import profileAvatar from "@/assets/images/profile/profile-avatar.png";
import IconSearch from "@/assets/icons/IconSearch.svg";
import LinkButton from "./LinkButton.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);
const isHome = currentPath === "" || currentPath === "/";

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="border-border bg-card text-accent absolute inset-s-4 -top-full z-[60] rounded-full border px-4 py-2 transition-all duration-150 focus:top-2"
>
  {t.a11y.skipToContent}
</a>

<header class="site-header" data-menu-state="closed">
  <nav class="site-nav" aria-label="主导航">
    <div class="site-nav-inner flex items-center">
      <a
        href={getRelativeLocaleUrl(locale, "")}
        class="text-foreground hover:text-foreground focus-visible:text-foreground active:text-foreground visited:text-foreground flex min-h-9 items-center gap-2.5 font-semibold whitespace-nowrap no-underline transition-opacity duration-150 hover:opacity-[0.78]"
        aria-label={t.notFound.goHome}
        aria-current={isHome ? "page" : undefined}
      >
        <Image
          src={profileAvatar}
          alt=""
          width={1024}
          height={1024}
          format="png"
          class="size-7 flex-none rounded-full object-cover"
        />
        <span class="text-base sm:text-[1.0625rem]">{site.title}</span>
      </a>

      <ul class="site-nav-links ms-auto hidden items-center gap-1 sm:flex">
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class:list={{ "active-nav": isActive("/posts") }}
            aria-current={isActive("/posts") ? "page" : undefined}
          >
            {t.nav.posts}
          </a>
        </li>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "about")}
            class:list={{ "active-nav": isActive("/about") }}
            aria-current={isActive("/about") ? "page" : undefined}
          >
            {t.nav.about}
          </a>
        </li>
      </ul>

      <div class="ms-auto flex items-center gap-1 sm:ms-2 sm:gap-1.5">
        {
          features.search !== false && (
            <LinkButton
              href={getRelativeLocaleUrl(locale, "search")}
              class:list={[
                "hover:text-accent flex size-9 justify-center p-0",
                { "active-nav": isActive("/search") },
              ]}
              title={t.nav.search}
              aria-label={t.nav.search}
              aria-current={isActive("/search") ? "page" : undefined}
            >
              <IconSearch aria-hidden="true" class="size-5" />
              <span class="sr-only">{t.nav.search}</span>
            </LinkButton>
          )
        }

        {features.lightAndDarkMode && <ThemeToggle />}

        <button
          id="menu-btn"
          type="button"
          class="menu-toggle hover:text-accent flex size-9 items-center justify-center border-0 bg-transparent p-0 transition-colors duration-150 sm:hidden"
          aria-label={t.a11y.openMenu}
          aria-expanded="false"
          aria-controls="mobile-menu-layer"
          data-label-open={t.a11y.openMenu}
          data-label-close={t.a11y.closeMenu}
          data-state="closed"
        >
          <span class="menu-toggle-icon" aria-hidden="true">
            <span class="menu-toggle-line menu-toggle-line-top"></span>
            <span class="menu-toggle-line menu-toggle-line-middle"></span>
            <span class="menu-toggle-line menu-toggle-line-bottom"></span>
          </span>
        </button>
      </div>
    </div>
  </nav>

  <div
    id="mobile-menu-layer"
    class="mobile-menu-layer sm:hidden"
    data-state="closed"
    aria-hidden="true"
    inert
  >
    <nav class="mobile-menu-panel" aria-label="移动导航">
      <ul id="menu-items" class="mobile-menu-list">
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class:list={{ "active-nav": isActive("/posts") }}
            aria-current={isActive("/posts") ? "page" : undefined}
          >
            {t.nav.posts}
          </a>
        </li>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "about")}
            class:list={{ "active-nav": isActive("/about") }}
            aria-current={isActive("/about") ? "page" : undefined}
          >
            {t.nav.about}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuLayer = document.querySelector<HTMLElement>("#mobile-menu-layer");
    const menuPanel =
      menuLayer?.querySelector<HTMLElement>(".mobile-menu-panel");
    const header = menuBtn?.closest<HTMLElement>(".site-header");

    if (!menuBtn || !menuLayer || !menuPanel || !header) return;
    if (menuBtn.dataset.menuBound === "true") return;
    menuBtn.dataset.menuBound = "true";

    const openLabel = menuBtn.dataset.labelOpen ?? "打开菜单";
    const closeLabel = menuBtn.dataset.labelClose ?? "关闭菜单";
    const desktopMedia = window.matchMedia("(min-width: 640px)");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let closeTimer = 0;

    const setMenuOpen = (open: boolean, restoreFocus = false) => {
      const wasOpen = menuBtn.getAttribute("aria-expanded") === "true";
      window.clearTimeout(closeTimer);

      menuBtn.setAttribute("aria-expanded", String(open));
      menuBtn.setAttribute("aria-label", open ? closeLabel : openLabel);
      menuBtn.dataset.state = open ? "open" : "closed";
      menuLayer.dataset.state = open ? "open" : "closed";
      header.dataset.menuState = open ? "open" : "closed";

      if (
        !open &&
        (restoreFocus || menuLayer.contains(document.activeElement))
      ) {
        menuBtn.focus({ preventScroll: true });
      }

      menuLayer.setAttribute("aria-hidden", String(!open));

      if (open) {
        menuLayer.inert = false;
      } else {
        const finishClosing = () => {
          menuLayer.inert = true;
        };
        if (reducedMotion.matches) finishClosing();
        else closeTimer = window.setTimeout(finishClosing, 220);
      }

      if (!wasOpen && !open) menuLayer.inert = true;
    };

    menuBtn.addEventListener("click", () => {
      setMenuOpen(menuBtn.getAttribute("aria-expanded") !== "true");
    });

    menuLayer.addEventListener("click", event => {
      if ((event.target as Element).closest("a")) setMenuOpen(false);
    });

    document.addEventListener("pointerdown", event => {
      if (menuBtn.getAttribute("aria-expanded") !== "true") return;
      const target = event.target as Node;
      if (!menuPanel.contains(target) && !menuBtn.contains(target)) {
        setMenuOpen(false);
      }
    });

    document.addEventListener("keydown", event => {
      if (
        event.key === "Escape" &&
        menuBtn.getAttribute("aria-expanded") === "true"
      ) {
        setMenuOpen(false, true);
      }
    });

    desktopMedia.addEventListener("change", event => {
      if (event.matches) setMenuOpen(false);
    });
  }

  setupMobileMenu();
</script>
