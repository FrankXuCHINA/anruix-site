<script is:inline>
  (() => {
    if (window.__articleTransitionInitialized) return;
    window.__articleTransitionInitialized = true;

    const NAVIGATION_CONTEXT_KEY = "anruix:article-transition:navigation";
    const ORIGINS_KEY = "anruix:article-transition:origins";
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const MAX_TITLE_TOKENS = 96;
    const MAX_EXCERPT_TOKENS = 160;
    const graphemeSegmenter =
      typeof Intl.Segmenter === "function"
        ? new Intl.Segmenter(document.documentElement.lang || "zh-CN", {
            granularity: "grapheme",
          })
        : null;
    let pendingCard = null;
    let outgoingCleanup = null;

    const normalizePath = value => {
      if (!value) return "";
      try {
        const path = new URL(value, window.location.origin).pathname;
        return path === "/" ? path : path.replace(/\/+$/, "");
      } catch {
        const path = String(value).split(/[?#]/, 1)[0] || "/";
        return path === "/" ? path : path.replace(/\/+$/, "");
      }
    };

    const readSessionValue = (key, fallback) => {
      try {
        const value = sessionStorage.getItem(key);
        return value ? JSON.parse(value) : fallback;
      } catch {
        return fallback;
      }
    };

    const writeSessionValue = (key, value) => {
      try {
        sessionStorage.setItem(key, JSON.stringify(value));
      } catch {
        // Navigation still works when storage is unavailable; only the
        // article-specific enhancement is skipped on a later traversal.
      }
    };

    const removeSessionValue = key => {
      try {
        sessionStorage.removeItem(key);
      } catch {
        // Nothing to clear when storage is unavailable.
      }
    };

    const skipTransition = transition => {
      if (!transition) return;
      transition.ready.catch(() => {});
      transition.skipTransition();
    };

    const isVisible = element =>
      Boolean(
        element &&
        !element.closest("[hidden]") &&
        element.getClientRects().length
      );

    const getCardPath = card => normalizePath(card?.dataset.articleUrl);

    const findCard = (articlePath, allowHidden = false) => {
      const cards = Array.from(
        document.querySelectorAll("[data-article-transition-card]")
      ).filter(card => getCardPath(card) === articlePath);
      return cards.find(isVisible) ?? (allowHidden ? cards[0] : null) ?? null;
    };

    const getSearchState = card => {
      const root = card?.closest("[data-post-search]");
      const query =
        root?.querySelector("input[type='search']")?.value.trim() ?? "";
      if (!root || !query) {
        return { query: "", resultPaths: [], statusText: "" };
      }

      const resultPaths = Array.from(root.querySelectorAll("[data-post-card]"))
        .filter(item => !item.hidden)
        .map(item => normalizePath(item.dataset.searchUrl))
        .filter(Boolean);

      return {
        query,
        resultPaths,
        statusText:
          root.querySelector("[data-search-status]")?.textContent?.trim() ?? "",
      };
    };

    const getDetail = () =>
      document.querySelector("[data-article-transition-detail]");

    const getNames = key => ({
      card: `article-card-${key}`,
      detailPage: `article-detail-page-${key}`,
      cover: `article-cover-${key}`,
      title: `article-title-${key}`,
      excerpt: `article-excerpt-${key}`,
      listMeta: `article-list-meta-${key}`,
      detailMeta: `article-detail-meta-${key}`,
    });

    const getIntro = root => {
      const body = root?.querySelector("[data-article-transition-body]");
      return (
        Array.from(body?.children ?? []).find(
          element =>
            element.matches("p") && Boolean(element.textContent?.trim())
        ) ?? null
      );
    };

    const getSharedText = root => ({
      title: root?.querySelector("[data-article-transition-title]") ?? null,
      excerpt:
        root?.querySelector("[data-article-transition-excerpt]") ??
        getIntro(root),
    });

    const normalizeSharedText = value =>
      String(value ?? "")
        .replace(/\s+/gu, " ")
        .trim();

    const splitGraphemes = value =>
      graphemeSegmenter
        ? Array.from(graphemeSegmenter.segment(value), item => item.segment)
        : Array.from(value);

    const tokenizeText = (element, field) => {
      const existing = Array.from(
        element.querySelectorAll(`[data-article-transition-token="${field}"]`)
      );
      if (existing.length) return existing;

      const textNodes = [];
      const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT);
      let current = walker.nextNode();
      while (current) {
        if (current.nodeValue) textNodes.push(current);
        current = walker.nextNode();
      }

      const tokens = [];
      for (const textNode of textNodes) {
        const fragment = document.createDocumentFragment();
        for (const segment of splitGraphemes(textNode.nodeValue ?? "")) {
          if (!segment || /^\s+$/u.test(segment)) {
            fragment.append(segment);
            continue;
          }

          const token = document.createElement("span");
          token.dataset.articleTransitionToken = field;
          token.dataset.articleTransitionTokenIndex = String(tokens.length);
          token.textContent = segment;
          fragment.append(token);
          tokens.push(token);
        }
        textNode.replaceWith(fragment);
      }

      return tokens;
    };

    const unwrapTextTokens = element => {
      const parents = new Set();
      element
        .querySelectorAll("[data-article-transition-token]")
        .forEach(token => {
          if (!token.parentNode) return;
          parents.add(token.parentNode);
          token.replaceWith(token.textContent ?? "");
        });
      parents.forEach(parent => parent.normalize());
    };

    const getVisibleTokenCount = (element, tokens) => {
      const bounds = element.getBoundingClientRect();
      let lastVisibleIndex = -1;

      tokens.forEach((token, index) => {
        const visible = Array.from(token.getClientRects()).some(
          rect =>
            rect.right > bounds.left &&
            rect.left < bounds.right &&
            rect.bottom > bounds.top &&
            rect.top < bounds.bottom
        );
        if (visible) lastVisibleIndex = index;
      });

      return lastVisibleIndex + 1;
    };

    const hashTokens = (tokens, count) => {
      let hash = 2166136261;
      for (const token of tokens.slice(0, count)) {
        for (const character of token.textContent ?? "") {
          hash ^= character.codePointAt(0) ?? 0;
          hash = Math.imul(hash, 16777619);
        }
      }
      return (hash >>> 0).toString(36);
    };

    const getTokenName = (key, field, index) =>
      `article-${field}-token-${key}-${index}`;

    const getBlockTextState = () => ({
      title: { mode: "block" },
      excerpt: { mode: "block" },
    });

    const prepareTextTransition = (info, element, names) => {
      const sharedText = getSharedText(element);
      const expectedText = {
        title: element.dataset.articleTransitionTitleText ?? "",
        excerpt: element.dataset.articleTransitionExcerptText ?? "",
      };
      const createsState = info.side === "list" && info.direction === "open";
      const state = createsState
        ? {}
        : (info.textTransition ?? getBlockTextState());
      const blockElements = [];
      const tokenElements = [];
      const tokenNames = [];
      const tokenizedElements = new Set();

      for (const field of ["title", "excerpt"]) {
        const textElement = sharedText[field];
        const blockName = names[field];
        const maxTokens =
          field === "title" ? MAX_TITLE_TOKENS : MAX_EXCERPT_TOKENS;

        if (
          !textElement ||
          !expectedText[field] ||
          normalizeSharedText(textElement.textContent) !==
            normalizeSharedText(expectedText[field])
        ) {
          if (!createsState && state[field]?.mode === "tokens") {
            tokenizedElements.forEach(unwrapTextTokens);
            return null;
          }
          if (createsState) state[field] = { mode: "block" };
          blockElements.push([textElement, blockName]);
          continue;
        }

        const fieldState = state[field];
        if (!createsState && fieldState?.mode !== "tokens") {
          blockElements.push([textElement, blockName]);
          continue;
        }

        const tokens = tokenizeText(textElement, field);
        tokenizedElements.add(textElement);
        const count = createsState
          ? field === "title"
            ? tokens.length
            : getVisibleTokenCount(textElement, tokens)
          : fieldState.count;

        if (
          !Number.isInteger(count) ||
          count < 1 ||
          count > maxTokens ||
          tokens.length < count
        ) {
          if (createsState) state[field] = { mode: "block" };
          unwrapTextTokens(textElement);
          tokenizedElements.delete(textElement);
          blockElements.push([textElement, blockName]);
          continue;
        }

        const hash = hashTokens(tokens, count);
        if (!createsState && hash !== fieldState.hash) {
          tokenizedElements.forEach(unwrapTextTokens);
          return null;
        }

        if (createsState) {
          state[field] = { mode: "tokens", count, hash };
        }

        tokens.slice(0, count).forEach((token, index) => {
          const tokenName = getTokenName(info.key, field, index);
          tokenElements.push([token, tokenName]);
          tokenNames.push(tokenName);
        });
      }

      info.textTransition = state;
      return {
        blockElements: blockElements.filter(([item]) => item),
        tokenElements,
        tokenNames,
        cleanup: () => tokenizedElements.forEach(unwrapTextTokens),
      };
    };

    const rememberOrigin = info => {
      const origins = readSessionValue(ORIGINS_KEY, {});
      origins[info.articlePath] = {
        key: info.key,
        listPath: info.listPath,
        searchQuery: info.searchQuery,
        searchResultPaths: info.searchResultPaths,
        searchStatusText: info.searchStatusText,
        textTransition: info.textTransition,
      };
      writeSessionValue(ORIGINS_KEY, origins);
    };

    const getRememberedOrigin = articlePath => {
      const origins = readSessionValue(ORIGINS_KEY, {});
      return origins[articlePath] ?? null;
    };

    const restoreSearchResult = (
      card,
      query,
      resultPaths = [],
      statusText = ""
    ) => {
      if (!query) return;

      const root = card.closest("[data-post-search]");
      const input = root?.querySelector("input[type='search']");
      const results = root?.querySelector("[data-search-results]");
      const list = root?.querySelector("[data-search-list]");
      const status = root?.querySelector("[data-search-status]");
      if (!root || !input || !results || !list || !status) return;

      const items = Array.from(root.querySelectorAll("[data-post-card]"));
      const itemsByPath = new Map(
        items.map(item => [normalizePath(item.dataset.searchUrl), item])
      );
      const fallbackPath = getCardPath(card);
      const orderedPaths = resultPaths.length
        ? resultPaths
        : fallbackPath
          ? [fallbackPath]
          : [];
      const orderedItems = orderedPaths
        .map(path => itemsByPath.get(path))
        .filter(Boolean);
      const visibleItems = new Set(orderedItems);

      input.value = query;
      results.hidden = false;
      items.forEach(item => (item.hidden = !visibleItems.has(item)));
      orderedItems.forEach(item => list.append(item));
      status.textContent = statusText;
      root.querySelector("[data-search-clear]")?.removeAttribute("hidden");
      document
        .querySelectorAll("[data-search-default]")
        .forEach(element => (element.hidden = true));
    };

    const installRuntimeStyles = (names, direction, tokenNames = []) => {
      document.getElementById("article-transition-runtime")?.remove();
      const style = document.createElement("style");
      style.id = "article-transition-runtime";
      const motionEasing = "cubic-bezier(0.2, 0.7, 0.2, 1)";
      const tokenSelector = (pseudo, names = tokenNames) =>
        names.map(name => `::view-transition-${pseudo}(${name})`).join(",\n");
      const titleTokenNames = tokenNames.filter(name =>
        name.startsWith("article-title-token-")
      );
      const excerptTokenNames = tokenNames.filter(name =>
        name.startsWith("article-excerpt-token-")
      );
      const tokenOpacityStyles = (names, oldKeyframes, newKeyframes) =>
        names.length
          ? `
        ${tokenSelector("old", names)} {
          animation: ${oldKeyframes} 320ms linear both;
        }

        ${tokenSelector("new", names)} {
          animation: ${newKeyframes} 320ms linear both;
        }
      `
          : "";
      const tokenStyles = tokenNames.length
        ? `
        ${tokenSelector("group")} {
          z-index: 4;
          animation-duration: 320ms;
          animation-timing-function: ${motionEasing};
          animation-fill-mode: both;
        }

        ${tokenSelector("image-pair")} {
          overflow: visible;
          isolation: isolate;
        }

        ${tokenSelector("old")},
        ${tokenSelector("new")} {
          width: 100%;
          height: 100%;
          mix-blend-mode: normal;
          backface-visibility: hidden;
          object-fit: contain;
          object-position: center;
          transform-origin: center;
        }

        ${tokenOpacityStyles(
          titleTokenNames,
          "article-transition-token-old",
          "article-transition-token-new"
        )}
        ${tokenOpacityStyles(
          excerptTokenNames,
          "article-transition-excerpt-token-old",
          "article-transition-excerpt-token-new"
        )}
      `
        : "";
      style.textContent = `
        ::view-transition-group(${names.detailPage}) {
          z-index: 0;
          animation: none;
        }

        ::view-transition-image-pair(${names.detailPage}) {
          isolation: isolate;
        }

        ::view-transition-new(${names.detailPage}) {
          width: 100%;
          height: 100%;
          mix-blend-mode: normal;
          backface-visibility: hidden;
          animation: article-transition-page-in 220ms
            ${motionEasing} 110ms both;
        }

        ::view-transition-group(${names.card}) {
          z-index: 1;
          animation: none;
        }

        ::view-transition-group(${names.cover}) {
          z-index: 2;
          animation: none;
        }

        ::view-transition-image-pair(${names.card}),
        ::view-transition-image-pair(${names.cover}) {
          overflow: clip;
          isolation: isolate;
        }

        ::view-transition-old(${names.card}),
        ::view-transition-new(${names.card}),
        ::view-transition-old(${names.cover}),
        ::view-transition-new(${names.cover}) {
          width: 100%;
          height: 100%;
          mix-blend-mode: normal;
          backface-visibility: hidden;
          object-fit: contain;
          object-position: center;
          transform-origin: center;
        }

        ::view-transition-old(${names.card}),
        ::view-transition-old(${names.cover}) {
          animation: article-transition-card-out 190ms
            ${motionEasing} both;
        }

        ::view-transition-new(${names.card}),
        ::view-transition-new(${names.cover}) {
          animation: article-transition-card-in 230ms
            ${motionEasing} 90ms both;
        }

        ::view-transition-group(${names.title}),
        ::view-transition-group(${names.excerpt}) {
          z-index: 4;
          animation-duration: 320ms;
          animation-timing-function: ${motionEasing};
          animation-fill-mode: both;
        }

        ::view-transition-group(${names.excerpt}) {
          z-index: 3;
        }

        ::view-transition-image-pair(${names.title}),
        ::view-transition-image-pair(${names.excerpt}) {
          overflow: visible;
          isolation: isolate;
        }

        ::view-transition-old(${names.title}),
        ::view-transition-new(${names.title}),
        ::view-transition-old(${names.excerpt}),
        ::view-transition-new(${names.excerpt}) {
          width: 100%;
          height: 100%;
          mix-blend-mode: normal;
          backface-visibility: hidden;
          object-fit: contain;
          object-position: left top;
          transform-origin: left top;
        }

        ::view-transition-old(${names.title}) {
          animation: article-transition-text-old 320ms linear both;
        }

        ::view-transition-new(${names.title}) {
          animation: article-transition-text-new 320ms linear both;
        }

        ::view-transition-old(${names.excerpt}) {
          animation: article-transition-text-old 320ms linear both;
        }

        ::view-transition-new(${names.excerpt}) {
          animation: article-transition-text-new 320ms linear both;
        }

        ${tokenStyles}

        ::view-transition-group(${names.listMeta}),
        ::view-transition-group(${names.detailMeta}) {
          z-index: 3;
          animation: none;
        }

        ::view-transition-old(${names.listMeta}),
        ::view-transition-old(${names.detailMeta}),
        ::view-transition-new(${names.listMeta}),
        ::view-transition-new(${names.detailMeta}) {
          width: 100%;
          height: 100%;
          mix-blend-mode: normal;
          backface-visibility: hidden;
        }

        ::view-transition-old(${names.listMeta}),
        ::view-transition-old(${names.detailMeta}) {
          animation: article-transition-meta-out 90ms ease-out both;
        }

        ::view-transition-new(${names.listMeta}),
        ::view-transition-new(${names.detailMeta}) {
          animation: article-transition-meta-in 130ms
            ${motionEasing}
            ${direction === "open" ? "170ms" : "180ms"} both;
        }
      `;
      document.head.append(style);
      return style;
    };

    const prepareTransition = info => {
      if (info.side === "list" && info.direction === "close") {
        restoreSearchResult(
          info.card,
          info.searchQuery,
          info.searchResultPaths,
          info.searchStatusText
        );
      }
      const element = info.side === "detail" ? info.detail : info.card;
      if (!element) return null;

      const names = getNames(info.key);
      const preparedText = prepareTextTransition(info, element, names);
      if (!preparedText) return null;
      const root = document.documentElement;
      const page = document.querySelector("main");
      // Only the opening detail page gets a page-level fade. On return, the
      // browser may finish native scroll restoration after the destination
      // snapshot is captured. Keeping the live list out of the overlay avoids
      // replacing a stale-position snapshot on the final frame.
      const isIncomingDetail =
        info.direction === "open" && info.side === "detail";
      const previousRootName = root.style.viewTransitionName;
      root.dataset.articleTransition = info.direction;
      root.style.viewTransitionName = "none";
      const sharedElements = [
        [isIncomingDetail ? page : null, names.detailPage],
        [
          info.side === "list"
            ? element.querySelector("[data-article-transition-shell]")
            : null,
          names.card,
        ],
        [
          info.side === "list"
            ? element.querySelector("[data-article-transition-cover]")
            : null,
          names.cover,
        ],
        ...preparedText.blockElements,
        ...preparedText.tokenElements,
        [
          element.querySelector("[data-article-transition-meta]"),
          info.side === "list" ? names.listMeta : names.detailMeta,
        ],
      ].filter(([element]) => element);
      sharedElements.forEach(
        ([element, name]) => (element.style.viewTransitionName = name)
      );
      const runtimeStyles = installRuntimeStyles(
        names,
        info.direction,
        preparedText.tokenNames
      );

      return () => {
        sharedElements.forEach(
          ([element]) => (element.style.viewTransitionName = "")
        );
        runtimeStyles.remove();
        preparedText.cleanup();
        root.style.viewTransitionName = previousRootName;
        delete root.dataset.articleTransition;
      };
    };

    const getSwapDestination = event =>
      normalizePath(event.activation?.entry?.url);

    const getSwapInfo = event => {
      const fromPath = normalizePath(window.location.href);
      const toPath = getSwapDestination(event);
      if (!toPath) return null;

      const detail = getDetail();
      if (!detail) {
        const card =
          pendingCard &&
          getCardPath(pendingCard) === toPath &&
          isVisible(pendingCard)
            ? pendingCard
            : findCard(toPath);
        if (!card) return null;

        const searchState = getSearchState(card);

        return {
          direction: "open",
          side: "list",
          key: card.dataset.articleTransitionKey,
          articlePath: toPath,
          listPath: fromPath,
          fromPath,
          toPath,
          searchQuery: searchState.query,
          searchResultPaths: searchState.resultPaths,
          searchStatusText: searchState.statusText,
          card,
        };
      }

      const articlePath = normalizePath(detail.dataset.articleUrl);
      const origin = getRememberedOrigin(articlePath);
      if (
        !origin ||
        origin.key !== detail.dataset.articleTransitionKey ||
        origin.listPath !== toPath
      ) {
        return null;
      }

      return {
        direction: "close",
        side: "detail",
        key: detail.dataset.articleTransitionKey,
        articlePath,
        listPath: toPath,
        fromPath,
        toPath,
        searchQuery: origin.searchQuery ?? "",
        searchResultPaths: origin.searchResultPaths ?? [],
        searchStatusText: origin.searchStatusText ?? "",
        textTransition: origin.textTransition ?? getBlockTextState(),
        detail,
      };
    };

    const getNavigationFromPath = () =>
      normalizePath(window.navigation?.activation?.from?.url);

    const getRevealInfo = () => {
      const currentPath = normalizePath(window.location.href);
      const fromPath = getNavigationFromPath();
      const stored = readSessionValue(NAVIGATION_CONTEXT_KEY, null);
      removeSessionValue(NAVIGATION_CONTEXT_KEY);
      let context = stored && stored.toPath === currentPath ? stored : null;

      const detail = getDetail();
      if (detail) {
        const articlePath = normalizePath(detail.dataset.articleUrl);
        const origin = getRememberedOrigin(articlePath);
        if (
          !context &&
          fromPath &&
          origin?.key === detail.dataset.articleTransitionKey &&
          origin.listPath === fromPath
        ) {
          context = {
            direction: "open",
            key: detail.dataset.articleTransitionKey,
            articlePath,
            listPath: fromPath,
            fromPath,
            toPath: currentPath,
            searchQuery: origin.searchQuery ?? "",
            searchResultPaths: origin.searchResultPaths ?? [],
            searchStatusText: origin.searchStatusText ?? "",
            textTransition: origin.textTransition ?? getBlockTextState(),
          };
        }
        if (
          !context ||
          context.direction !== "open" ||
          context.articlePath !== articlePath ||
          context.key !== detail.dataset.articleTransitionKey
        ) {
          return null;
        }
        return { ...context, side: "detail", detail };
      }

      const articlePath = context?.articlePath || fromPath;
      const origin = articlePath ? getRememberedOrigin(articlePath) : null;
      const searchQuery = context?.searchQuery ?? origin?.searchQuery ?? "";
      const searchResultPaths =
        context?.searchResultPaths ?? origin?.searchResultPaths ?? [];
      const searchStatusText =
        context?.searchStatusText ?? origin?.searchStatusText ?? "";
      const textTransition =
        context?.textTransition ??
        origin?.textTransition ??
        getBlockTextState();
      const card = articlePath
        ? findCard(articlePath, Boolean(searchQuery))
        : null;
      if (
        !context &&
        card &&
        fromPath &&
        origin?.key === card.dataset.articleTransitionKey &&
        origin.listPath === currentPath
      ) {
        context = {
          direction: "close",
          key: card.dataset.articleTransitionKey,
          articlePath: fromPath,
          listPath: currentPath,
          fromPath,
          toPath: currentPath,
          searchQuery,
          searchResultPaths,
          searchStatusText,
          textTransition,
        };
      }
      if (
        !context ||
        context.direction !== "close" ||
        context.listPath !== currentPath ||
        !card ||
        context.key !== card.dataset.articleTransitionKey
      ) {
        return null;
      }
      return {
        ...context,
        searchQuery,
        searchResultPaths,
        searchStatusText,
        textTransition,
        side: "list",
        card,
      };
    };

    document.addEventListener(
      "click",
      event => {
        if (
          event.defaultPrevented ||
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          pendingCard = null;
          return;
        }
        pendingCard =
          event.target.closest?.("[data-article-transition-card]") ?? null;
      },
      true
    );

    window.addEventListener("pageswap", event => {
      outgoingCleanup?.();
      outgoingCleanup = null;
      pendingCard =
        pendingCard && document.contains(pendingCard) ? pendingCard : null;

      if (!event.viewTransition || reduceMotion.matches) {
        skipTransition(event.viewTransition);
        removeSessionValue(NAVIGATION_CONTEXT_KEY);
        pendingCard = null;
        return;
      }

      event.viewTransition.ready.catch(() => {});
      const info = getSwapInfo(event);
      pendingCard = null;
      if (!info?.key) {
        skipTransition(event.viewTransition);
        removeSessionValue(NAVIGATION_CONTEXT_KEY);
        return;
      }

      const cleanup = prepareTransition(info);
      if (!cleanup) {
        skipTransition(event.viewTransition);
        removeSessionValue(NAVIGATION_CONTEXT_KEY);
        return;
      }

      if (info.direction === "open") rememberOrigin(info);
      writeSessionValue(NAVIGATION_CONTEXT_KEY, {
        direction: info.direction,
        key: info.key,
        articlePath: info.articlePath,
        listPath: info.listPath,
        fromPath: info.fromPath,
        toPath: info.toPath,
        searchQuery: info.searchQuery,
        searchResultPaths: info.searchResultPaths,
        searchStatusText: info.searchStatusText,
        textTransition: info.textTransition,
      });
      outgoingCleanup = cleanup;
      event.viewTransition.finished.then(cleanup, cleanup);
    });

    window.addEventListener("pagereveal", event => {
      if (!event.viewTransition || reduceMotion.matches) {
        skipTransition(event.viewTransition);
        removeSessionValue(NAVIGATION_CONTEXT_KEY);
        return;
      }

      const info = getRevealInfo();
      if (!info?.key) {
        skipTransition(event.viewTransition);
        return;
      }

      const cleanup = prepareTransition(info);
      if (!cleanup) {
        skipTransition(event.viewTransition);
        return;
      }
      event.viewTransition.ready.catch(cleanup);
      event.viewTransition.finished.then(cleanup, cleanup);
    });

    window.addEventListener("pageshow", () => {
      if (document.documentElement.dataset.articleTransition) return;
      outgoingCleanup?.();
      outgoingCleanup = null;
      pendingCard = null;
    });
  })();
</script>
