<script is:inline>
  (() => {
    if (window.__articleTransitionInitialized) return;
    window.__articleTransitionInitialized = true;

    const NAVIGATION_CONTEXT_KEY = "anruix:article-transition:navigation";
    const ORIGINS_KEY = "anruix:article-transition:origins";
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let pendingCard = null;
    let outgoingCleanup = null;

    const normalizePath = value => {
      if (!value) return "";
      try {
        const path = new URL(value, window.location.origin).pathname;
        return path === "/" ? path : path.replace(/\/+$/, "");
      } catch {
        const path = String(value).split(/[?#]/, 1)[0] || "/";
        return path === "/" ? path : path.replace(/\/+$/, "");
      }
    };

    const readSessionValue = (key, fallback) => {
      try {
        const value = sessionStorage.getItem(key);
        return value ? JSON.parse(value) : fallback;
      } catch {
        return fallback;
      }
    };

    const writeSessionValue = (key, value) => {
      try {
        sessionStorage.setItem(key, JSON.stringify(value));
      } catch {
        // Navigation still works when storage is unavailable; only the
        // article-specific enhancement is skipped on a later traversal.
      }
    };

    const removeSessionValue = key => {
      try {
        sessionStorage.removeItem(key);
      } catch {
        // Nothing to clear when storage is unavailable.
      }
    };

    const skipTransition = transition => {
      if (!transition) return;
      transition.ready.catch(() => {});
      transition.skipTransition();
    };

    const isVisible = element =>
      Boolean(
        element &&
        !element.closest("[hidden]") &&
        element.getClientRects().length
      );

    const getCardPath = card => normalizePath(card?.dataset.articleUrl);

    const findCard = (articlePath, allowHidden = false) => {
      const cards = Array.from(
        document.querySelectorAll("[data-article-transition-card]")
      ).filter(card => getCardPath(card) === articlePath);
      return cards.find(isVisible) ?? (allowHidden ? cards[0] : null) ?? null;
    };

    const getSearchQuery = card =>
      card
        ?.closest("[data-post-search]")
        ?.querySelector("input[type='search']")
        ?.value.trim() ?? "";

    const getDetail = () =>
      document.querySelector("[data-article-transition-detail]");

    const getSurface = () =>
      document.querySelector("[data-article-transition-surface]");

    const getName = key => `article-surface-${key}`;

    const rememberOrigin = info => {
      const origins = readSessionValue(ORIGINS_KEY, {});
      origins[info.articlePath] = {
        key: info.key,
        listPath: info.listPath,
        searchQuery: info.searchQuery,
      };
      writeSessionValue(ORIGINS_KEY, origins);
    };

    const getRememberedOrigin = articlePath => {
      const origins = readSessionValue(ORIGINS_KEY, {});
      return origins[articlePath] ?? null;
    };

    const clearSurface = surface => {
      if (!surface) return;
      surface.hidden = true;
      surface.style.viewTransitionName = "";
      surface.removeAttribute("data-article-transition-direction");
      surface
        .querySelector("[data-article-transition-surface-viewport]")
        ?.replaceChildren();
    };

    const restoreSearchResult = (card, query) => {
      if (!query || isVisible(card)) return;

      const root = card.closest("[data-post-search]");
      const input = root?.querySelector("input[type='search']");
      const results = root?.querySelector("[data-search-results]");
      if (!root || !input || !results) return;

      input.value = query;
      results.hidden = false;
      card.hidden = false;
      root.querySelector("[data-search-clear]")?.removeAttribute("hidden");
      document
        .querySelectorAll("[data-search-default]")
        .forEach(element => (element.hidden = true));

      window.setTimeout(() => {
        input.dispatchEvent(new Event("input", { bubbles: true }));
      }, 0);
    };

    const populateSurface = (detail, direction) => {
      const surface = getSurface();
      const viewport = surface?.querySelector(
        "[data-article-transition-surface-viewport]"
      );
      if (!surface || !viewport) return null;

      const clone = detail.cloneNode(true);
      clone.classList.add("article-transition-surface-page");
      clone.removeAttribute("data-pagefind-body");
      clone.removeAttribute("data-article-transition-detail");
      clone.removeAttribute("data-article-transition-key");
      clone.removeAttribute("data-article-url");
      clone
        .querySelectorAll("script, style, #btt-btn-container")
        .forEach(node => node.remove());
      clone
        .querySelectorAll("[id]")
        .forEach(node => node.removeAttribute("id"));

      viewport.replaceChildren(clone);
      surface.dataset.articleTransitionDirection = direction;
      surface.hidden = false;

      const surfaceRect = surface.getBoundingClientRect();
      const detailRect = detail.getBoundingClientRect();
      clone.style.transform = `translateY(${Math.round(
        detailRect.top - surfaceRect.top
      )}px)`;

      return surface;
    };

    const installRuntimeStyles = (name, direction) => {
      document.getElementById("article-transition-runtime")?.remove();
      const style = document.createElement("style");
      style.id = "article-transition-runtime";
      style.textContent = `
        ::view-transition-group(${name}) {
          z-index: 2;
          animation-duration: 300ms;
          animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
        }

        ::view-transition-image-pair(${name}) {
          overflow: clip;
          background: var(--background);
          box-shadow: 0 18px 56px rgb(0 0 0 / 0.16);
          animation: article-transition-radius-${direction} 300ms
            cubic-bezier(0.22, 1, 0.36, 1) both;
        }

        ::view-transition-old(${name}),
        ::view-transition-new(${name}) {
          width: 100%;
          height: 100%;
          mix-blend-mode: normal;
          backface-visibility: hidden;
        }

        ::view-transition-old(${name}) {
          animation: article-transition-snapshot-out 300ms
            cubic-bezier(0.22, 1, 0.36, 1) both;
        }

        ::view-transition-new(${name}) {
          animation: article-transition-snapshot-in 300ms
            cubic-bezier(0.22, 1, 0.36, 1) both;
        }
      `;
      document.head.append(style);
      return style;
    };

    const prepareTransition = info => {
      if (info.side === "list" && info.direction === "close") {
        restoreSearchResult(info.card, info.searchQuery);
      }
      const element =
        info.side === "detail"
          ? populateSurface(info.detail, info.direction)
          : info.card;
      if (!element) return null;

      const name = getName(info.key);
      document.documentElement.dataset.articleTransition = info.direction;
      element.style.viewTransitionName = name;
      const runtimeStyles = installRuntimeStyles(name, info.direction);

      return () => {
        element.style.viewTransitionName = "";
        if (info.side === "detail") clearSurface(element);
        runtimeStyles.remove();
        delete document.documentElement.dataset.articleTransition;
      };
    };

    const getSwapDestination = event =>
      normalizePath(event.activation?.entry?.url);

    const getSwapInfo = event => {
      const fromPath = normalizePath(window.location.href);
      const toPath = getSwapDestination(event);
      if (!toPath) return null;

      const detail = getDetail();
      if (!detail) {
        const card =
          pendingCard &&
          getCardPath(pendingCard) === toPath &&
          isVisible(pendingCard)
            ? pendingCard
            : findCard(toPath);
        if (!card) return null;

        return {
          direction: "open",
          side: "list",
          key: card.dataset.articleTransitionKey,
          articlePath: toPath,
          listPath: fromPath,
          fromPath,
          toPath,
          searchQuery: getSearchQuery(card),
          card,
        };
      }

      const articlePath = normalizePath(detail.dataset.articleUrl);
      const origin = getRememberedOrigin(articlePath);
      if (
        !origin ||
        origin.key !== detail.dataset.articleTransitionKey ||
        origin.listPath !== toPath
      ) {
        return null;
      }

      return {
        direction: "close",
        side: "detail",
        key: detail.dataset.articleTransitionKey,
        articlePath,
        listPath: toPath,
        fromPath,
        toPath,
        searchQuery: origin.searchQuery ?? "",
        detail,
      };
    };

    const getNavigationFromPath = () =>
      normalizePath(window.navigation?.activation?.from?.url);

    const getRevealInfo = () => {
      const currentPath = normalizePath(window.location.href);
      const fromPath = getNavigationFromPath();
      const stored = readSessionValue(NAVIGATION_CONTEXT_KEY, null);
      removeSessionValue(NAVIGATION_CONTEXT_KEY);
      let context = stored && stored.toPath === currentPath ? stored : null;

      const detail = getDetail();
      if (detail) {
        const articlePath = normalizePath(detail.dataset.articleUrl);
        const origin = getRememberedOrigin(articlePath);
        if (
          !context &&
          fromPath &&
          origin?.key === detail.dataset.articleTransitionKey &&
          origin.listPath === fromPath
        ) {
          context = {
            direction: "open",
            key: detail.dataset.articleTransitionKey,
            articlePath,
            listPath: fromPath,
            fromPath,
            toPath: currentPath,
            searchQuery: origin.searchQuery ?? "",
          };
        }
        if (
          !context ||
          context.direction !== "open" ||
          context.articlePath !== articlePath ||
          context.key !== detail.dataset.articleTransitionKey
        ) {
          return null;
        }
        return { ...context, side: "detail", detail };
      }

      const articlePath = context?.articlePath || fromPath;
      const origin = articlePath ? getRememberedOrigin(articlePath) : null;
      const searchQuery = context?.searchQuery ?? origin?.searchQuery ?? "";
      const card = articlePath
        ? findCard(articlePath, Boolean(searchQuery))
        : null;
      if (
        !context &&
        card &&
        fromPath &&
        origin?.key === card.dataset.articleTransitionKey &&
        origin.listPath === currentPath
      ) {
        context = {
          direction: "close",
          key: card.dataset.articleTransitionKey,
          articlePath: fromPath,
          listPath: currentPath,
          fromPath,
          toPath: currentPath,
          searchQuery,
        };
      }
      if (
        !context ||
        context.direction !== "close" ||
        context.listPath !== currentPath ||
        !card ||
        context.key !== card.dataset.articleTransitionKey
      ) {
        return null;
      }
      return { ...context, searchQuery, side: "list", card };
    };

    document.addEventListener(
      "click",
      event => {
        if (
          event.defaultPrevented ||
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          pendingCard = null;
          return;
        }
        pendingCard =
          event.target.closest?.("[data-article-transition-card]") ?? null;
      },
      true
    );

    window.addEventListener("pageswap", event => {
      outgoingCleanup?.();
      outgoingCleanup = null;
      pendingCard =
        pendingCard && document.contains(pendingCard) ? pendingCard : null;

      if (!event.viewTransition || reduceMotion.matches) {
        skipTransition(event.viewTransition);
        removeSessionValue(NAVIGATION_CONTEXT_KEY);
        pendingCard = null;
        return;
      }

      event.viewTransition.ready.catch(() => {});
      const info = getSwapInfo(event);
      pendingCard = null;
      if (!info?.key) {
        skipTransition(event.viewTransition);
        removeSessionValue(NAVIGATION_CONTEXT_KEY);
        return;
      }

      if (info.direction === "open") rememberOrigin(info);
      writeSessionValue(NAVIGATION_CONTEXT_KEY, {
        direction: info.direction,
        key: info.key,
        articlePath: info.articlePath,
        listPath: info.listPath,
        fromPath: info.fromPath,
        toPath: info.toPath,
        searchQuery: info.searchQuery,
      });

      const cleanup = prepareTransition(info);
      if (!cleanup) {
        skipTransition(event.viewTransition);
        removeSessionValue(NAVIGATION_CONTEXT_KEY);
        return;
      }
      outgoingCleanup = cleanup;
      event.viewTransition.finished.then(cleanup, cleanup);
    });

    window.addEventListener("pagereveal", event => {
      if (!event.viewTransition || reduceMotion.matches) {
        skipTransition(event.viewTransition);
        removeSessionValue(NAVIGATION_CONTEXT_KEY);
        return;
      }

      const info = getRevealInfo();
      if (!info?.key) {
        skipTransition(event.viewTransition);
        return;
      }

      const cleanup = prepareTransition(info);
      if (!cleanup) {
        skipTransition(event.viewTransition);
        return;
      }
      event.viewTransition.ready.then(() => {
        if (info.side === "detail") clearSurface(getSurface());
        else info.card.style.viewTransitionName = "";
      }, cleanup);
      event.viewTransition.finished.then(cleanup, cleanup);
    });

    window.addEventListener("pageshow", () => {
      outgoingCleanup?.();
      outgoingCleanup = null;
      pendingCard = null;
      clearSurface(getSurface());
    });
  })();
</script>
