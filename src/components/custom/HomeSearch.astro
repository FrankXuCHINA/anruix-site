---
import type { CollectionEntry } from "astro:content";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconX from "@/assets/icons/IconX.svg";
import PostCard from "./PostCard.astro";
import { useTranslations } from "@/i18n";

type Props = {
  posts: CollectionEntry<"posts">[];
};

const { posts } = Astro.props;
const t = useTranslations(Astro.currentLocale);
---

<section
  class="home-search"
  data-post-search
  data-label-loading={t.search.pagefind.loading}
  data-label-empty={t.a11y.noResults}
  data-label-error={t.search.pagefind.error_search}
>
  <form class="home-search-form" role="search">
    <div class="home-search-input-wrap">
      <IconSearch aria-hidden="true" class="home-search-icon" />
      <input
        class="home-search-input"
        type="search"
        name="q"
        placeholder="搜索文章标题、描述或内容…"
        aria-label="搜索文章"
        autocomplete="off"
      />
      <button
        type="button"
        class="home-search-clear"
        data-search-clear
        aria-label="清除搜索内容"
        title="清除"
        hidden
      >
        <IconX aria-hidden="true" class="home-search-clear-icon" />
      </button>
    </div>
  </form>

  <div class="home-search-results" data-search-results hidden>
    <div class="home-search-results-heading">
      <h2>{t.search.pagefind.results_label}</h2>
      <p data-search-status aria-live="polite"></p>
    </div>
    <ul class="article-card-list" data-search-list>
      {posts.map(post => <PostCard {post} searchable hidden />)}
    </ul>
  </div>
</section>

<script>
  import { setupPostSearch } from "@/scripts/postSearch";

  setupPostSearch();
</script>

<style>
  .home-search {
    width: 100%;
  }

  .home-search-form {
    margin: 0;
  }

  .home-search-input-wrap {
    position: relative;
  }

  .home-search-icon {
    position: absolute;
    top: 50%;
    left: 1rem;
    width: 1.125rem;
    height: 1.125rem;
    color: var(--muted-foreground);
    pointer-events: none;
    transform: translateY(-50%);
  }

  .home-search-input {
    width: 100%;
    height: var(--article-search-height);
    padding: 0 2.75rem;
    color: var(--foreground);
    font-size: 1rem;
    background: var(--muted);
    border: 1px solid var(--border);
    border-radius: var(--article-search-radius);
    appearance: none;
    transition:
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .home-search-input::placeholder {
    color: var(--subtle-foreground);
    opacity: 1;
  }

  .home-search-input::-webkit-search-cancel-button,
  .home-search-input::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
  }

  .home-search-input::-ms-clear {
    display: none;
  }

  .home-search-input:focus-visible {
    border-color: var(--accent);
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .home-search-clear {
    position: absolute;
    top: 50%;
    right: 0.4375rem;
    display: flex;
    width: 2.25rem;
    height: 2.25rem;
    align-items: center;
    justify-content: center;
    padding: 0;
    color: var(--muted-foreground);
    background: transparent;
    border: 0;
    transform: translateY(-50%);
    transition: color 160ms ease;
  }

  .home-search-clear[hidden] {
    display: none;
  }

  .home-search-clear:hover {
    color: var(--accent);
  }

  .home-search-clear-icon {
    width: 1.125rem;
    height: 1.125rem;
  }

  .home-search-results {
    margin-top: 2rem;
  }

  .home-search-results-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 1.25rem;
  }

  .home-search-results-heading h2 {
    color: var(--foreground);
    font-size: clamp(1.5rem, 4vw, 1.75rem);
    font-weight: 700;
    line-height: 1.25;
  }

  .home-search-results-heading p {
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }
</style>
