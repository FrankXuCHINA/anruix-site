---
import type { MarkdownHeading } from "astro";
import { useTranslations } from "@/i18n";

type Props = {
  headings: MarkdownHeading[];
  variant: "desktop" | "mobile";
};

const { headings, variant } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const tocHeadings = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

{
  tocHeadings.length > 0 && variant === "desktop" && (
    <div class="article-toc-desktop">
      <nav
        class="article-toc-card"
        aria-label={t.post.tocLabel}
        data-article-toc
      >
        <p class="article-toc-title">{t.post.tableOfContents}</p>
        <ul class="article-toc-list">
          {tocHeadings.map(({ depth, slug, text }) => (
            <li>
              <a
                class="article-toc-link"
                data-depth={depth}
                data-heading-id={slug}
                href={`#${slug}`}
              >
                {text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  )
}

{
  tocHeadings.length > 0 && variant === "mobile" && (
    <details class="article-toc-mobile">
      <summary>{t.post.tableOfContents}</summary>
      <nav aria-label={t.post.tocLabel} data-article-toc>
        <ul class="article-toc-list">
          {tocHeadings.map(({ depth, slug, text }) => (
            <li>
              <a
                class="article-toc-link"
                data-depth={depth}
                data-heading-id={slug}
                href={`#${slug}`}
              >
                {text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  )
}
