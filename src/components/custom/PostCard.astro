---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import dayjsTimezone from "dayjs/plugin/timezone";
import { getPostReadingStats } from "@/utils/getPostReadingStats";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import config from "@/config";

type Props = {
  post: CollectionEntry<"posts">;
  priority?: boolean;
  searchable?: boolean;
  hidden?: boolean;
};

dayjs.extend(utc);
dayjs.extend(dayjsTimezone);

const {
  post,
  priority = false,
  searchable = false,
  hidden = false,
} = Astro.props;
const { id, data, filePath, body = "" } = post;
const {
  title,
  description,
  pubDatetime,
  timezone,
  featured,
  cover,
  coverAlt,
} = data;
const postUrl = getPostUrl(id, filePath, Astro.currentLocale);
const date = dayjs(pubDatetime)
  .tz(timezone ?? config.site.timezone)
  .format("YYYY年M月D日");
const { wordCount, readingMinutes } = getPostReadingStats(body);
const formattedWordCount = new Intl.NumberFormat("zh-CN").format(wordCount);
const placeholderText = title.trim().charAt(0) || "安";
---

<li
  class="post-card-item"
  data-post-card={searchable ? "" : undefined}
  data-search-url={searchable ? postUrl : undefined}
  data-search-title={searchable ? title : undefined}
  data-search-description={searchable ? description : undefined}
  data-search-content={searchable ? body : undefined}
  data-search-path={searchable ? postUrl : undefined}
  {hidden}
>
  <article>
    <a class="post-card" href={postUrl}>
      <div class="post-card-cover">
        {
          typeof cover === "string" ? (
            <img
              src={cover}
              alt={coverAlt ?? ""}
              width="720"
              height="480"
              loading={priority ? "eager" : "lazy"}
              fetchpriority={priority ? "high" : "auto"}
              decoding="async"
            />
          ) : cover ? (
            <Image
              src={cover}
              alt={coverAlt ?? ""}
              width={720}
              height={480}
              loading={priority ? "eager" : "lazy"}
              fetchpriority={priority ? "high" : "auto"}
              decoding="async"
            />
          ) : (
            <div class="post-card-placeholder" aria-hidden="true">
              <span>{placeholderText}</span>
            </div>
          )
        }
      </div>

      <div class="post-card-content">
        <div class="post-card-meta">
          {featured && <span class="post-card-pinned">置顶</span>}
          <span>{date}</span>
          <span aria-hidden="true">·</span>
          <span>{formattedWordCount} 字</span>
          <span aria-hidden="true">·</span>
          <span>约 {readingMinutes} 分钟</span>
        </div>

        <h3
          class="post-card-title"
          transition:name={searchable ? undefined : toTransitionName(title)}
        >
          {title}
        </h3>
        <p class="post-card-description">{description}</p>
      </div>
    </a>
  </article>
</li>

<style>
  .post-card-item {
    min-width: 0;
    list-style: none;
  }

  .post-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1rem;
    color: var(--foreground);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    text-decoration: none;
    transition:
      color 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .post-card:hover {
    color: var(--foreground);
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .post-card-cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--muted);
    border-radius: 0.875rem;
  }

  .post-card-cover :global(img),
  .post-card-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-card-placeholder {
    display: grid;
    place-items: center;
    color: var(--accent);
    background: var(--accent-soft);
  }

  .post-card-placeholder span {
    font-size: clamp(2.5rem, 12vw, 4.5rem);
    font-weight: 700;
    line-height: 1;
    opacity: 0.42;
  }

  .post-card-content {
    min-width: 0;
  }

  .post-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .post-card-pinned {
    margin-inline-end: 0.25rem;
    padding: 0.15rem 0.5rem;
    color: var(--background);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
    background: var(--foreground);
    border-radius: 9999px;
  }

  .post-card-title {
    margin-top: 0.75rem;
    color: var(--foreground);
    font-size: 1.625rem;
    font-weight: 700;
    line-height: 1.24;
    letter-spacing: normal;
    overflow-wrap: anywhere;
    transition: color 180ms ease;
  }

  .post-card:hover .post-card-title {
    color: var(--accent);
  }

  .post-card-description {
    display: -webkit-box;
    margin-top: 0.75rem;
    overflow: hidden;
    color: var(--muted-foreground);
    font-size: 1rem;
    line-height: 1.6;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  @media (min-width: 768px) {
    .post-card {
      display: grid;
      grid-template-columns: 13.5rem minmax(0, 1fr);
      gap: 1.5rem;
      align-items: center;
      padding: 1.375rem;
    }

    .post-card-cover {
      aspect-ratio: 3 / 2;
    }

    .post-card-placeholder span {
      font-size: 3.5rem;
    }

    .post-card-description {
      -webkit-line-clamp: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card,
    .post-card-title {
      transition: none;
    }

    .post-card:hover {
      transform: none;
    }
  }
</style>
