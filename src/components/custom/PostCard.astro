---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import dayjsTimezone from "dayjs/plugin/timezone";
import { countContentWords } from "@/utils/countContentWords";
import { getPostExcerpt } from "@/utils/getPostExcerpt";
import { getPostSlug, getPostUrl } from "@/utils/getPostPaths";
import { getPostTransitionKey } from "@/utils/getPostTransitionKey";
import config from "@/config";

type Props = {
  post: CollectionEntry<"posts">;
  priority?: boolean;
  searchable?: boolean;
  hidden?: boolean;
};

dayjs.extend(utc);
dayjs.extend(dayjsTimezone);

const {
  post,
  priority = false,
  searchable = false,
  hidden = false,
} = Astro.props;
const { id, data, filePath, body = "" } = post;
const { title, description, pubDatetime, timezone, featured, cover, coverAlt } =
  data;
const postUrl = getPostUrl(id, filePath, Astro.currentLocale);
const transitionKey = getPostTransitionKey(getPostSlug(id, filePath));
const date = dayjs(pubDatetime)
  .tz(timezone ?? config.site.timezone)
  .format("YYYY年M月D日");
const wordCount = countContentWords(body);
const formattedWordCount = new Intl.NumberFormat("zh-CN").format(wordCount);
const excerpt = getPostExcerpt(body, description);
const placeholderText = title.trim().charAt(0) || "安";
---

<li
  class="post-card-item"
  data-post-card={searchable ? "" : undefined}
  data-search-url={searchable ? postUrl : undefined}
  {hidden}
>
  <article>
    <a
      class="post-card"
      href={postUrl}
      data-article-transition-card
      data-article-transition-key={transitionKey}
      data-article-url={postUrl}
      data-article-transition-title-text={title}
      data-article-transition-excerpt-text={excerpt}
    >
      <span
        class="post-card-transition-shell"
        data-article-transition-shell
        aria-hidden="true"></span>

      <div class="post-card-cover" data-article-transition-cover>
        {
          typeof cover === "string" ? (
            <img
              src={cover}
              alt={coverAlt ?? ""}
              width="720"
              height="480"
              loading={priority ? "eager" : "lazy"}
              fetchpriority={priority ? "high" : "auto"}
              decoding="async"
            />
          ) : cover ? (
            <Image
              src={cover}
              alt={coverAlt ?? ""}
              width={720}
              height={480}
              loading={priority ? "eager" : "lazy"}
              fetchpriority={priority ? "high" : "auto"}
              decoding="async"
            />
          ) : (
            <div class="post-card-placeholder" aria-hidden="true">
              <span>{placeholderText}</span>
            </div>
          )
        }
      </div>

      <div class="post-card-content">
        <div class="post-card-meta" data-article-transition-meta>
          {featured && <span class="post-card-pinned">置顶</span>}
          <span>{date}</span>
          <span aria-hidden="true">·</span>
          <span>{formattedWordCount} 字</span>
        </div>

        <h3 class="post-card-title" data-article-transition-title>
          {title}
        </h3>
        <p class="post-card-description" data-article-transition-excerpt>
          {excerpt}
        </p>
      </div>
    </a>
  </article>
</li>

<style>
  .post-card-item {
    min-width: 0;
    list-style: none;
  }

  .post-card {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: var(--article-card-gap);
    padding: var(--article-card-padding);
    color: var(--foreground);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 1.25rem;
    text-decoration: none;
  }

  .post-card-transition-shell {
    position: absolute;
    inset: -1px;
    z-index: 0;
    pointer-events: none;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: inherit;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.035);
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .post-card:hover {
    color: var(--foreground);
  }

  .post-card:hover .post-card-transition-shell {
    border-color: color-mix(in srgb, var(--border) 78%, var(--foreground) 22%);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  }

  .post-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .post-card-cover {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--muted);
    border-radius: 0.875rem;
  }

  .post-card-cover :global(img),
  .post-card-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .post-card-placeholder {
    display: grid;
    place-items: center;
    color: var(--accent);
    background: var(--accent-soft);
  }

  .post-card-placeholder span {
    font-size: clamp(2.5rem, 12vw, 4.5rem);
    font-weight: 700;
    line-height: 1;
    opacity: 0.42;
  }

  .post-card-content {
    position: relative;
    z-index: 1;
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-self: stretch;
    justify-content: flex-start;
  }

  .post-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .post-card-pinned {
    margin-inline-end: 0.25rem;
    padding: 0.15rem 0.5rem;
    color: var(--background);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
    background: var(--foreground);
    border-radius: 9999px;
  }

  .post-card-title {
    margin-top: 0.5rem;
    color: var(--foreground);
    font-size: 1.625rem;
    font-weight: 700;
    line-height: 1.24;
    letter-spacing: normal;
    overflow-wrap: anywhere;
  }

  .post-card-description {
    display: -webkit-box;
    margin-top: 0.5rem;
    overflow: hidden;
    color: var(--muted-foreground);
    font-size: 1rem;
    line-height: 1.6;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  @media (min-width: 768px) {
    .post-card {
      display: grid;
      grid-template-columns: var(--article-cover-width) minmax(0, 1fr);
      gap: var(--article-card-gap);
      align-items: start;
      padding: var(--article-card-padding);
    }

    .post-card-cover {
      aspect-ratio: 3 / 2;
    }

    .post-card-content {
      padding-top: 0.25rem;
    }

    .post-card-placeholder span {
      font-size: 3.5rem;
    }

    .post-card-description {
      -webkit-line-clamp: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card-transition-shell {
      transition: none;
    }
  }

  :global([data-theme="dark"]) .post-card:hover .post-card-transition-shell {
    border-color: color-mix(in srgb, var(--border) 76%, var(--foreground) 24%);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }
</style>
