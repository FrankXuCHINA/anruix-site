---
import IconChevronUp from "@/assets/icons/IconChevronUp.svg";
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro.currentLocale);
---

<div class="article-back-to-top" data-state="hidden">
  <button
    type="button"
    data-button="back-to-top"
    aria-label={t.post.backToTop}
    title={t.post.backToTop}
  >
    <IconChevronUp aria-hidden="true" class="size-5" />
  </button>
</div>

<script is:inline>
  function setupBackToTop() {
    const container = document.querySelector(".article-back-to-top");
    const button = container?.querySelector("[data-button='back-to-top']");

    if (!container || !button) return;
    if (button.dataset.bound === "true") return;
    button.dataset.bound = "true";

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let ticking = false;

    const updateVisibility = () => {
      container.dataset.state = window.scrollY >= 300 ? "visible" : "hidden";
    };

    button.addEventListener("click", () => {
      window.scrollTo({
        top: 0,
        behavior: reducedMotion.matches ? "auto" : "smooth",
      });
    });

    document.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(() => {
          updateVisibility();
          ticking = false;
        });
      },
      { passive: true }
    );
    window.addEventListener("pageshow", updateVisibility);

    updateVisibility();
  }

  setupBackToTop();
</script>
