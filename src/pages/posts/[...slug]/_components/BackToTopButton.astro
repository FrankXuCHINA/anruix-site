---
import IconArrowNarrowUp from "@/assets/icons/IconArrowNarrowUp.svg";
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro.currentLocale);
---

<div class="article-back-to-top">
  <button
    type="button"
    data-article-back-to-top
    aria-label={t.post.backToTop}
    title={t.post.backToTop}
  >
    <IconArrowNarrowUp aria-hidden="true" class="size-4" />
  </button>
</div>
