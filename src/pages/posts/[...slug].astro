---
import { render } from "astro:content";
import License from "@components/misc/License.astro";
import Markdown from "@components/common/Markdown.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import {
	getCategoryUrl,
	getFileDirFromPath,
	getPostUrlBySlug,
	removeFileExtension,
} from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import CoverImage from "@/components/common/CoverImage.astro";
import PostMetadata from "@/components/layout/PostMeta.astro";
import { coverImageConfig, licenseConfig } from "@/config";
import { profileConfig, siteConfig } from "../../config";
import {
	getApiUrlList,
	processCoverImageSync,
} from "../../utils/image-utils";
import {
	getAuthorAvatarUrl,
	getSiteLogo,
	toAbsoluteImageInfo,
} from "@/utils/schema-image";
import {
	buildBreadcrumbList,
	buildPersonEntity,
	buildPublisherEntity,
	toAbsoluteUrl,
} from "@/utils/schema-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => ({
		params: { slug: removeFileExtension(entry.id) },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const description =
	entry.data.description ||
	remarkPluginFrontmatter.excerpt ||
	siteConfig.description;
const processedImage = processCoverImageSync(entry.data.image, entry.id);
const apiUrls = getApiUrlList(entry.data.image, entry.id);
const showPostCover = Boolean(
	processedImage &&
		coverImageConfig.enableInPost &&
		entry.data.showCoverInPost !== false,
);
const usePostCoverOverlay =
	showPostCover && (coverImageConfig.enableInPostOverlay ?? true);
const bannerPostMeta = {
	title: entry.data.title,
	description: entry.data.description,
	published: entry.data.published,
	updated: entry.data.updated,
	words: remarkPluginFrontmatter.words,
	minutes: remarkPluginFrontmatter.minutes,
};

const coverBasePath = getFileDirFromPath(entry.filePath || "");
const coverImage =
	(await toAbsoluteImageInfo(
		processedImage,
		coverBasePath,
		siteConfig.site_url,
	)) ?? undefined;

const aboutUrl =
	toAbsoluteUrl("/about/", siteConfig.site_url) ?? siteConfig.site_url;
const authorPerson = buildPersonEntity({
	site: siteConfig.site_url,
	profileConfig,
	authorUrl: aboutUrl,
	avatarUrl: await getAuthorAvatarUrl(),
	description: profileConfig.bio,
});
const publisher = buildPublisherEntity({
	site: siteConfig.site_url,
	siteConfig,
	logo: await getSiteLogo(),
});
const breadcrumbItems = [
	{
		name: i18n(I18nKey.home),
		url: toAbsoluteUrl("/", siteConfig.site_url) ?? siteConfig.site_url,
	},
];
if (entry.data.category) {
	breadcrumbItems.push({
		name: entry.data.category,
		url:
			toAbsoluteUrl(getCategoryUrl(entry.data.category), siteConfig.site_url) ??
			siteConfig.site_url,
	});
}
breadcrumbItems.push({ name: entry.data.title, url: Astro.url.toString() });

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "BlogPosting",
			headline: entry.data.title,
			description,
			keywords: entry.data.tags.length ? entry.data.tags.join(", ") : undefined,
			author: { "@id": authorPerson["@id"] },
			publisher: { "@id": publisher["@id"] },
			...(coverImage
				? {
						image: {
							"@type": "ImageObject",
							url: coverImage.url,
							contentUrl: coverImage.url,
							...(coverImage.width ? { width: coverImage.width } : {}),
							...(coverImage.height ? { height: coverImage.height } : {}),
						},
					}
				: {}),
			datePublished: entry.data.published.toISOString(),
			...(entry.data.updated
				? { dateModified: entry.data.updated.toISOString() }
				: {}),
			...(entry.data.category ? { articleSection: entry.data.category } : {}),
			...(remarkPluginFrontmatter.words
				? { wordCount: remarkPluginFrontmatter.words }
				: {}),
			mainEntityOfPage: { "@type": "WebPage", "@id": Astro.url.toString() },
			url: Astro.url.toString(),
			inLanguage: entry.data.lang
				? entry.data.lang.replace("_", "-")
				: siteConfig.lang.replace("_", "-"),
		},
		authorPerson,
		publisher,
		buildBreadcrumbList(breadcrumbItems),
	],
};
---
<MainGridLayout title={entry.data.title} description={description} lang={entry.data.lang} setOGTypeArticle={true} postSlug={entry.id} postCoverImage={coverImage?.url} postCategory={entry.data.category || undefined} ogImageWidth={coverImage?.width} ogImageHeight={coverImage?.height} ogImageAlt={entry.data.title} headings={headings} bannerPostMeta={bannerPostMeta}>
    <Fragment slot="head">
        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
        <meta property="article:published_time" content={entry.data.published.toISOString()}>
        {entry.data.updated && <meta property="article:modified_time" content={entry.data.updated.toISOString()}>}
        <meta property="article:author" content={entry.data.author || profileConfig.name}>
        {entry.data.category && <meta property="article:section" content={entry.data.category}>}
        {entry.data.tags.map((tag) => <meta property="article:tag" content={tag.trim()}>)}
    </Fragment>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div id="post-container" class:list={["card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full ",
            {}
        ]}>
            {usePostCoverOverlay && processedImage && (
                <div class="-mx-6 md:-mx-9 -mt-6 mb-6 h-48 md:h-64 relative onload-animation">
                    <CoverImage id="post-cover" src={processedImage} basePath={getFileDirFromPath(entry.filePath || "")} alt={entry.data.title} class="h-full" preview={false} apiUrls={apiUrls} />
                    <div class="absolute inset-x-0 bottom-0 px-6 md:px-9 pt-10 pb-3 bg-gradient-to-t from-black/80 via-black/45 to-transparent">
                        <div data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title" class="mb-2 text-xl md:text-2xl font-bold leading-tight text-white">
                            {entry.data.title}
                        </div>
                        <PostMetadata variant="cover" className="gap-x-4 gap-y-1" published={entry.data.published} updated={entry.data.updated} category={entry.data.category || undefined} tags={entry.data.tags} id={entry.id} />
                    </div>
                </div>
            )}
            <!-- word count and reading time -->
            {!usePostCoverOverlay && <div class="flex flex-row text-black/30 dark:text-white/30 gap-5 mb-3 transition onload-animation">
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:notes-rounded"></Icon>
                    </div>
                    <div class="text-sm">{remarkPluginFrontmatter.words} {" " + i18n(I18nKey.wordsCount)}</div>
                </div>
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:schedule-outline-rounded"></Icon>
                    </div>
                    <div class="text-sm">
                        {remarkPluginFrontmatter.minutes} {" " + i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                    </div>
                </div>
            </div>}

            <!-- title -->
            {!usePostCoverOverlay && <div class="relative onload-animation">
                <h1
                    data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title"
                    class="transition w-full block font-bold mb-3
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-[0.75rem] before:left-[-1.125rem]
                ">
                    {entry.data.title}
                </h1>
            </div>}

            <!-- metadata -->
            {!usePostCoverOverlay && <div class="onload-animation">
                <PostMetadata
                        className="mb-5"
                        published={entry.data.published}
                        updated={entry.data.updated}
                        tags={entry.data.tags}
                        category={entry.data.category || undefined}
                        id={entry.id}
                ></PostMetadata>
                {!showPostCover && <div class="border-[var(--line-divider)] border-dashed border-b-[1px] mb-5"></div>}
            </div>}

            <!-- Show the cover on the post page unless the article opts out. -->

            {showPostCover && !usePostCoverOverlay && processedImage &&
                <CoverImage id="post-cover" src={processedImage} basePath={getFileDirFromPath(entry.filePath || "")} alt={entry.data.title} class="mb-8 rounded-xl onload-animation" preview={false} naturalHeight apiUrls={apiUrls}/>
            }


            <Markdown class="mb-6 markdown-content onload-animation">
                <Content />
            </Markdown>

            {licenseConfig.enable && <License
                title={entry.data.title}
                id={entry.id}
                pubDate={entry.data.published}
                author={entry.data.author}
                sourceLink={entry.data.sourceLink}
                licenseName={entry.data.licenseName}
                licenseUrl={entry.data.licenseUrl}
                class="mb-6 rounded-xl license-container onload-animation"
            />}

        </div>
    </div>

    <div class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full">
        <a href={entry.data.nextSlug ? getPostUrlBySlug(entry.data.nextSlug) : "#"}
           tabindex={entry.data.nextSlug ? undefined : -1}
           aria-hidden={entry.data.nextSlug ? undefined : "true"}
           class:list={["w-full font-bold overflow-hidden active:scale-95", {"pointer-events-none": !entry.data.nextSlug}]}>
            {entry.data.nextSlug && <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-start gap-4" >
                <Icon name="material-symbols:chevron-left-rounded" class="text-[2rem] text-[var(--primary)]" />
                <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                    {entry.data.nextTitle}
                </div>
            </div>}
        </a>

        <a href={entry.data.prevSlug ? getPostUrlBySlug(entry.data.prevSlug) : "#"}
           tabindex={entry.data.prevSlug ? undefined : -1}
           aria-hidden={entry.data.prevSlug ? undefined : "true"}
           class:list={["w-full font-bold overflow-hidden active:scale-95", {"pointer-events-none": !entry.data.prevSlug}]}>
            {entry.data.prevSlug && <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-end gap-4">
                <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                    {entry.data.prevTitle}
                </div>
                <Icon name="material-symbols:chevron-right-rounded" class="text-[2rem] text-[var(--primary)]" />
            </div>}
        </a>
    </div>

</MainGridLayout>
