---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import ProfileHero from "@/components/custom/ProfileHero.astro";
import HomeSearch from "@/components/custom/HomeSearch.astro";
import PostCard from "@/components/custom/PostCard.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePosts = [...featuredPosts, ...recentPosts].slice(
  0,
  postsConfig.perIndex
);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="w-full"
  >
    <ProfileHero />

    <div class="article-listing-layout">
      <HomeSearch posts={sortedPosts} mode="home" />

      <div data-search-default>
        {
          homePosts.length > 0 && (
            <section id="recent-posts" class="home-posts">
              <ul class="article-card-list">
                {homePosts.map((post, index) => (
                  <PostCard {post} priority={index === 0} />
                ))}
              </ul>
            </section>
          )
        }

        <div class="home-all-posts">
          <LinkButton
            class="button-primary"
            href={getRelativeLocaleUrl(locale, "posts")}
          >
            {t.home.allPosts}
            <IconArrowRight class="inline-block rtl:-rotate-180" />
          </LinkButton>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>

<style>
  .home-posts {
    padding-block: 1.75rem 1rem;
  }

  .home-all-posts {
    margin-block: 2rem 3rem;
    text-align: center;
  }

  @media (min-width: 640px) {
    .home-posts {
      padding-top: 2rem;
    }
  }
</style>
