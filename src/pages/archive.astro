---
import ArchivePanel from "@components/controls/ArchivePanel.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { siteConfig } from "../config";
---

<MainGridLayout title={i18n(I18nKey.archive)} description={`${siteConfig.title}的文章归档，按时间浏览拍摄技巧、后期制作与创作记录。`}>
    <ArchivePanel />
</MainGridLayout>
